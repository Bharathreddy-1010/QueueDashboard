
{
  "name": "queuepro",
  "version": "1.0.0",
  "description": "QueuePro - Real-time Queue Management System MVP",
  "main": "server/server.js",
  "scripts": {
    "setup": "npm install && cd server && npm install && cd ../client && npm install",
    "seed": "cd server && npm run seed",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "cd server && npm run dev",
    "client:dev": "cd client && npm run dev",
    "vercel-build": "cd client && npm install && npm run build",
    "build": "cd client && npm install && npm run build",
    "test": "cd server && npm test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "queue",
    "management",
    "realtime",
    "socket.io",
    "react",
    "express",
    "mongodb"
  ],
  "author": "QueuePro Engineering",
  "license": "MIT"
}
